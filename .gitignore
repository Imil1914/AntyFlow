# Зависимости и артефакты сборки (пересоздаются командами npm)
node_modules/
.pnpm-store/
out/
dist/
release/

# Сайдкары (крупные бинарники: OpenCode, приватный Node, OpenScience, AnythingLLM).
# Наполняется scripts/prepare-sidecars.mjs, в git не коммитим.
sidecars/

# Логи и мусор ОС
*.log
.DS_Store
Thumbs.db

# Cloudflare Wrangler (локальное состояние/логи sync-сервера)
.wrangler/
sync-server/.wrangler/

# Планирование/служебное (не часть продукта)
.planning/
.agents/
.claude/
skills-lock.json

# Посторонние эксперименты, не относящиеся к Flow
ос/
Opensciens/

# Проектные PDF-спеки (при желании закоммить вручную)
*.pdf

# Локальные данные/секреты (их тут быть не должно, но подстрахуемся)
*.env
.env.*
providers.json
auth.json

# Локальное окружение и результаты проверок Plane baseline
infra/plane/.runtime/

# Wave artefacts of the no-commit workflow (history lives in plane-fork commits)
docs/superpowers/plans/*/pre/
docs/superpowers/plans/*/pre-docs/
docs/superpowers/plans/*/checkpoints/
docs/superpowers/plans/*/*.patch
